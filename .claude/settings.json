{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(/Applications/FreeCAD.app/Contents/Resources/bin/freecadcmd *)",
      "Bash(freecadcmd *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(/referenz/**)",
      "Edit(/archiv/**)",
      "Edit(/gehaeuse/archiv/**)",
      "Edit(/gehaeuse/modell/**)",
      "Read(/archiv/**)",
      "Read(/gehaeuse/archiv/**)",
      "Read(**/*.FCBak)",
      "Read(/gehaeuse/fem/ergebnisse/*/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pruefe_skript.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pruefbericht_aktuell.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sitzungsstart.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
